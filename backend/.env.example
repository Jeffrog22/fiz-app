# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon

# JWT (IMPORTANTE: Use uma chave complexa e única em produção!)
JWT_SECRET=seu-segredo-jwt-aqui
JWT_EXPIRES_IN=24h

# Server
PORT=3001
NODE_ENV=development

# CORS (IMPORTANTE: Defina a URL específica do seu frontend em produção, ex: https://meuapp.pages.dev)
# Múltiplas URLs separadas por vírgula: CORS_ORIGINS=https://app.meusite.com,https://admin.meusite.com
CORS_ORIGINS=*
FRONTEND_URL=*

# PIN de cada unidade (protege o primeiro acesso contra uso não autorizado)
PIN_BELA_VISTA=3210
PIN_SAO_MATHEUS=5432
PIN_VILA=6543
PIN_PARQUE=4321
PIN_3AIDADE=7654

# VAPID (Web Push)
VAPID_PUBLIC_KEY=sua-chave-publica-vapid
VAPID_PRIVATE_KEY=sua-chave-privada-vapid
VAPID_SUBJECT=mailto:admin@fizapp.com

# Fuso horário usado pelo scheduler de notificações
# Os horarios/dias_semana de notificacoes_config são interpretados neste fuso
NOTIF_TIMEZONE=America/Sao_Paulo